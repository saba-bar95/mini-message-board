<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: "New Message" }) %>
  </head>
  <body>
    <main class="container">
      <form method="POST" action="/new">
        <h2>New Message</h2>

        <!-- Display validation errors if any exist -->
        <% if (locals.errors && errors.length > 0) { %>
          <div class="error-banner" style="color: red; margin-bottom: 1rem;">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <label for="author">
          <input 
            type="text" 
            name="author" 
            placeholder="Author" 
            id="author" 
            value="<%= locals.oldInput ? oldInput.author : '' %>"
            required 
          />
        </label>

        <label for="message">
          <input 
            type="text" 
            name="message" 
            placeholder="Message" 
            id="message" 
            value="<%= locals.oldInput ? oldInput.message : '' %>"
            required 
          />
        </label>

        <button type="submit">Submit</button>
      </form>
    </main>
  </body>
</html>