<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <main class="container">
      <h1>Mini Message Board</h1>
      <a href="/new">Add a new message</a>

      <ul>
        <% messages.forEach((message) => { %>
        <li>
          <div>
            <!-- Display the text and the database username -->
            <p><strong><%= message.username %></strong>: <%= message.text %></p>

            <!-- Use message.id for your detail/open link instead of index + 1 -->
            <a href="/message/<%= message.id %>">details</a>
          </div>
        </li>
        <% }); %>
      </ul>
    </main>
  </body>
</html>
