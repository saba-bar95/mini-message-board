<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <main class="container">
      <h1>Mini Message Board</h1>
      <a href="/new">Add a new message</a>
      <ul>
        <% messages.forEach((message, index) => { %>
        <li>
          <div>
            <p>Message: <span><%= message.text %></span></p>
            <a href="/message/<%= index+1 %>">details</a>
          </div>
        </li>
        <% }); %>
      </ul>
    </main>
  </body>
</html>
