<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <main class="container">
      <div>
        <p>Message: <span><%= message.text %></span></p>
      </div>
      <div>
        <p>Author: <span><%= message.user %></span></p>
